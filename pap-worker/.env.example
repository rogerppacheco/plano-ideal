# Copie para pap-worker/.env (local) ou configure no Railway (serviço plano-ideal-pap)

DATABASE_URL=postgresql://usuario:senha@host:porta/railway
DB_SCHEMA=plano_ideal

# Mesmo valor nos serviços plano-ideal-api e plano-ideal-pap
PAP_CREDENTIALS_SECRET=

PAP_HEADLESS=true
PAP_CREDITO_FAST_MODE=true
PAP_OS_FAST_MODE=true
PAP_CAPTURE_SCREENSHOTS_OS=false
PAP_CREDITO_MAX_CONSULTAS_POR_TT_DIA=6
PAP_WORKER_POLL_SECONDS=2
PAP_BO_LOCK_TIMEOUT_MINUTES=30

# Etapa 4 — contato (igual site-record)
# Padrão: gera e-mail único @mailinator.com a cada consulta (Nio valida entrega).
CREDITO_EMAIL_MAILINATOR=true
# Alternativa: pool de e-mails reais (desative mailinator com CREDITO_EMAIL_MAILINATOR=false)
# CREDITO_EMAILS=email1@dominio.com,email2@dominio.com
