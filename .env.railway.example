# Copie para .env.railway (não vai para o GitHub)
# Token: https://railway.com/account/tokens

RAILWAY_TOKEN=

# Opcional se o script não achar o projeto pelo nome
# RAILWAY_PROJECT_ID=

# Postgres (mesmo banco do Record). Pode omitir se existir serviço Postgres no projeto.
DATABASE_URL=postgresql://usuario:senha@host:porta/railway

# Opcional — senão o script gera um aleatório
# JWT_SECRET=
