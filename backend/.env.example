PORT=4000
DATABASE_URL=postgresql://usuario:senha@host:5432/railway
DB_SCHEMA=plano_ideal
# IMPORT_BATCH_SIZE=500
# true | false | omitido (auto: SSL em hosts Railway, sem SSL em localhost)
DATABASE_SSL=
JWT_SECRET=trocar-por-um-segredo-forte
FRONTEND_ORIGIN=https://seu-frontend.up.railway.app
IMPORT_JOB_STALE_HOURS=168

# Consulta de fachadas Nio (DFV) via API pública do Power BI
# Relatórios padrão: Sudeste + SP + Sul + Centro-Oeste + Norte/Nordeste (mesma entidade BASE_HP_F)
DFV_POWERBI_ENABLED=true
DFV_POWERBI_CLUSTER=https://wabi-brazil-south-b-primary-api.analysis.windows.net
# Overrides opcionais por região (padrões já embutidos no código):
# DFV_POWERBI_RESOURCE_KEY=8a9db8f9-7cf1-4db5-90d2-5259ad149eba      (Sudeste)
# DFV_POWERBI_MODEL_ID=6061538
# DFV_POWERBI_SP_RESOURCE_KEY=81e95c1a-e770-44e3-9646-19df8443756c
# DFV_POWERBI_SP_MODEL_ID=7340452
# DFV_POWERBI_SUL_RESOURCE_KEY=cc212c25-1b6a-4301-877b-703e2c7aa788
# DFV_POWERBI_SUL_MODEL_ID=6062850
# DFV_POWERBI_CO_RESOURCE_KEY=a321b404-8186-4645-8070-507a8fea6abb
# DFV_POWERBI_CO_MODEL_ID=6063900
# DFV_POWERBI_NNE_RESOURCE_KEY=7b6cd391-63ef-4af2-9b09-1b0b1caa29a9
# DFV_POWERBI_NNE_MODEL_ID=6064171
# Ou lista completa (JSON) — substitui todos os padrões acima:
# DFV_POWERBI_SOURCES=[{"id":"sudeste","label":"DFV Sudeste","resourceKey":"8a9db8f9-7cf1-4db5-90d2-5259ad149eba","modelId":6061538},{"id":"sp","label":"DFV SP","resourceKey":"81e95c1a-e770-44e3-9646-19df8443756c","modelId":7340452},{"id":"sul","label":"DFV Sul","resourceKey":"cc212c25-1b6a-4301-877b-703e2c7aa788","modelId":6062850},{"id":"co","label":"DFV Centro-Oeste","resourceKey":"a321b404-8186-4645-8070-507a8fea6abb","modelId":6063900},{"id":"nne","label":"DFV Norte e Nordeste","resourceKey":"7b6cd391-63ef-4af2-9b09-1b0b1caa29a9","modelId":6064171}]
DFV_POWERBI_TIMEOUT_SECONDS=18
DFV_POWERBI_CACHE_TTL_SECONDS=600
DFV_POWERBI_WINDOW_COUNT=5000
DFV_POWERBI_MAX_PAGES=20
